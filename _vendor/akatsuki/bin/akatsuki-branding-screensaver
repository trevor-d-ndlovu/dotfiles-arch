#!/bin/bash

# akatsuki:summary=Edit, set, or reset screensaver branding
# akatsuki:group=branding
# akatsuki:name=screensaver
# akatsuki:args=<image|text|reset>
# akatsuki:examples=akatsuki branding screensaver image | akatsuki branding screensaver text | akatsuki branding screensaver reset

set -euo pipefail

case "${1:-}" in
image)
  image=$(akatsuki-menu-file "Logo image" "$HOME" "svg png")
  if [[ -n $image ]] && akatsuki-transcode-ascii "$image" ~/.config/akatsuki/branding/screensaver.txt; then
    akatsuki-launch-screensaver force >/dev/null 2>&1
  fi
  ;;
text)
  akatsuki-launch-editor ~/.config/akatsuki/branding/screensaver.txt >/dev/null 2>&1 && akatsuki-launch-screensaver force >/dev/null 2>&1
  ;;
reset)
  cp "$AKATSUKI_PATH/logo.txt" ~/.config/akatsuki/branding/screensaver.txt && akatsuki-launch-screensaver force >/dev/null 2>&1
  ;;
*)
  echo "Usage: akatsuki-branding-screensaver <image|text|reset>" >&2
  exit 1
  ;;
esac
