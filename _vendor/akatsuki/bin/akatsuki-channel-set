#!/bin/bash

# akatsuki:summary=Set the Akatsuki channel, which dictates what git branch and package repository is used.
# akatsuki:args=<stable|rc|edge|dev>
# akatsuki:requires-sudo=true

if (($# == 0)); then
  echo "Usage: akatsuki-channel-set [stable|rc|edge|dev]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable") akatsuki-branch-set "master" && akatsuki-refresh-pacman "stable" ;;
"rc") akatsuki-branch-set "rc" && akatsuki-refresh-pacman "rc" ;;
"edge") akatsuki-branch-set "master" && akatsuki-refresh-pacman "edge" ;;
"dev") akatsuki-branch-set "dev" && akatsuki-refresh-pacman "edge" ;;
*) echo "Unknown channel: $channel"; exit 1; ;;
esac

akatsuki-update -y
