#!/bin/bash

# akatsuki:summary=Launch or focus on a given web app identified by the window-pattern.
# akatsuki:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: akatsuki-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="akatsuki-launch-webapp $@"

exec akatsuki-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
