#!/bin/bash

# akatsuki:summary=Overwrite all the user configs in ~/.config/hypr with the Akatsuki defaults.

akatsuki-refresh-config hypr/autostart.conf
akatsuki-refresh-config hypr/bindings.conf
akatsuki-refresh-config hypr/input.conf
akatsuki-refresh-config hypr/looknfeel.conf
akatsuki-refresh-config hypr/hyprland.conf
akatsuki-refresh-config hypr/monitors.conf
bash "$AKATSUKI_PATH/install/config/detect-keyboard-layout.sh"
