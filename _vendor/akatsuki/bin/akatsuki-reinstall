#!/bin/bash

# akatsuki:summary=Reinstall Akatsuki packages and reset default configs
# akatsuki:requires-sudo=true

set -e

# Attempt to reinstall all default Akatsuki packages and reset all the default configs.

echo -e "This will reinstall all the default Akatsuki packages and reset all default configs.\nWarning: All user changes to configs will be lost.\n"

if gum confirm "Are you sure you want to reinstall and lose all config changes?"; then
  akatsuki-reinstall-git
  akatsuki-reinstall-pkgs
  akatsuki-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && akatsuki-system-reboot
fi
