#!/bin/bash

# akatsuki:summary=Reboot after closing application windows
# akatsuki:examples=akatsuki reboot | akatsuki system reboot
# akatsuki:aliases=akatsuki reboot

akatsuki-state clear re*-required

# Schedule the reboot to happen after closing windows (detached from terminal)
nohup bash -c "sleep 2 && systemctl reboot --no-wall" >/dev/null 2>&1 &

# Now close all windows
akatsuki-hyprland-window-close-all
sleep 1 # Allow apps like Chrome to shutdown correctly
