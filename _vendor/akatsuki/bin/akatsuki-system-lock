#!/bin/bash

# akatsuki:summary=Lock the computer and turn off the display
# akatsuki:group=system
# akatsuki:name=lock
# akatsuki:examples=akatsuki system lock

if ! pidof hyprlock >/dev/null; then
  (
    hyprlock
    akatsuki-system-wake
  ) &
fi

# Set keyboard layout to default (first layout)
hyprctl switchxkblayout all 0 > /dev/null 2>&1

# Ensure 1password is locked
if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

# Avoid running screensaver when locked
pkill -f org.akatsuki.screensaver

if [[ ${AKATSUKI_LOCK_ONLY:-false} != "true" ]]; then
  (
    sleep 3
    pidof hyprlock >/dev/null || exit 0
    akatsuki-brightness-keyboard off
    akatsuki-brightness-display off
  ) &
fi
