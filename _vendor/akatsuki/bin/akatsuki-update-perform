#!/bin/bash

# akatsuki:summary=Run the full Akatsuki update pipeline
# akatsuki:requires-sudo=true

set -e

# Ensure screensaver/sleep doesn't set in during updates
hyprctl dispatch tagwindow +noidle &>/dev/null || true

# Perform all update steps
akatsuki-update-keyring
akatsuki-update-available-reset
akatsuki-update-system-pkgs
akatsuki-migrate
akatsuki-update-aur-pkgs
akatsuki-update-orphan-pkgs
akatsuki-hook post-update

akatsuki-update-analyze-logs

akatsuki-update-restart

# Re-enable screensaver/sleep after updates
hyprctl dispatch tagwindow -- -noidle &>/dev/null || true
