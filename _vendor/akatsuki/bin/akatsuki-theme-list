#!/bin/bash

# akatsuki:summary=List available themes
# akatsuki:examples=akatsuki theme list | akatsuki theme set "Tokyo Night"

{
  find ~/.config/akatsuki/themes/ -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  find "$AKATSUKI_PATH/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
