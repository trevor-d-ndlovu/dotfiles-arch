#!/bin/bash

# akatsuki:summary=Reinstall all default Akatsuki packages from the stable channel
# akatsuki:requires-sudo=true

set -e

# Reinstall all default Akatsuki packages from the stable channel and downgrade any packages that are too new.

# Set the package repository to the stable mirrors
akatsuki-refresh-pacman

# Downgrade any packages to the stable setup
sudo pacman -Suu --noconfirm

# Ensure all packages are installed
mapfile -t packages < <(grep -v '^#' "$AKATSUKI_PATH/install/akatsuki-base.packages" | grep -v '^$')
sudo pacman -Syu --noconfirm --needed "${packages[@]}"
