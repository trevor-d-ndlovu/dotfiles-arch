#!/bin/bash

# akatsuki:summary=Display keyboard brightness level using SwayOSD on the current monitor.
# akatsuki:args=<0-100>
# akatsuki:examples=akatsuki swayosd kbd brightness 0 | akatsuki swayosd kbd brightness 50 | akatsuki swayosd kbd brightness 100

percent="$1"

progress="$(awk -v p="$percent" 'BEGIN{printf "%.2f", p/100}')"
[[ $progress == "0.00" ]] && progress="0.01"

akatsuki-swayosd-client \
  --custom-icon keyboard-brightness-symbolic \
  --custom-progress "$progress" \
  --custom-progress-text "${percent}%"
